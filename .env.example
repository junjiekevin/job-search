# Supabase — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
# Default LLM (per-call override allowed); fallbacks wired in lib/ai/client.ts
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# GCP 
GCP_CLIENT_ID=
GCP_CLIENT_SECRET=

# Job Boards
REED_API_KEY=
ADZUNA_APP_ID=
ADZUNA_API_KEY=